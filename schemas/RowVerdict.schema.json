{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/RowVerdict.schema.json",
  "title": "RowVerdict",
  "description": "한 줄의 판정: 통과면 샘플(계약 ActionExtractionSample/ResponseSample)과 빈 사유, 실패면 sample null과 사유 코드. row_split은 행의 split 값(문자열로 바꾼 것)이고 객체가 아닌 줄은 null.",
  "type": "object",
  "properties": {
    "sample": {
      "type": [
        "object",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "row_split": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "sample",
    "reasons",
    "row_split"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "sample": {
          "type": "object"
        },
        "reasons": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "sample": {
          "type": "null"
        },
        "reasons": {
          "minItems": 1
        }
      }
    }
  ]
}
