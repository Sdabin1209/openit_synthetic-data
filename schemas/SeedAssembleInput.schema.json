{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/SeedAssembleInput.schema.json",
  "title": "SeedAssembleInput",
  "description": "시드 샘플 조립 입력: 짝과 그 문항 세트의 문항 ID들.",
  "type": "object",
  "properties": {
    "pairs": {
      "type": "array",
