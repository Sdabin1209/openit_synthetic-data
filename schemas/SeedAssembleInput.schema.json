{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/SeedAssembleInput.schema.json",
  "title": "SeedAssembleInput",
  "description": "시드 샘플 조립 입력: 짝과 그 문항 세트의 문항 ID들.",
  "type": "object",
  "properties": {
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seed": {
            "$ref": "Seed.schema.json"
          },
          "ref": {
            "type": "object"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_question_ids": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ],
            "description": "변경 분류의 affected_slots에서 읽은 문항 ID(정렬). null이면 문항 제한이 없다(변경 분류를 읽지 않았거나 REGENERATE_SAMPLES인데 영향 칸 목록이 비었다)."
          }
        },
        "required": [
          "seed",
          "ref",
          "question_ids",
          "affected_question_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pairs"
  ],
  "additionalProperties": false
}
