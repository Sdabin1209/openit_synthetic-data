{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SyntheticDefs.schema.json",
  "title": "SyntheticDefs",
  "description": "synthetic-data 잡 설정(run, import)이 함께 쓰는 정의. output.store는 store/spec.py(parse_store)의 동작을 옮긴 것이다. 식별자·해시·ArtifactRef는 _common.schema.json을 쓰며 여기서 다시 정의하지 않는다. 예시는 $defs/Store 또는 $defs/Output으로 검증한다.",
  "$defs": {
    "Store": {
      "description": "게시 대상 저장소. file·memory는 로컬 개발용, 운영은 http(dataset-store, D100). 토큰 값은 설정에 넣지 않고 token_env(비밀 이름)로만 받는다(D84): 'token' 키는 additionalProperties:false로 거부된다.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "root"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "root": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "memory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base_url"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "base_url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "token_env": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_dir",
        "store"
      ],
      "properties": {
        "work_dir": {
          "type": "string",
          "minLength": 1
        },
        "store": {
          "$ref": "#/$defs/Store"
        }
      }
    }
  }
}
