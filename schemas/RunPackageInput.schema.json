{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/RunPackageInput.schema.json",
  "title": "RunPackageInput",
  "description": "시드 잡 패키징 입력.",
  "type": "object",
  "properties": {
    "samples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object"
          },
          "usage": {
            "enum": [
              "TRAIN_POOL",
              "HELD_OUT_EVAL"
            ]
          }
        },
        "required": [
          "ref",
          "usage"
        ],
        "additionalProperties": false
      }
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_version": {
      "type": "integer",
      "minimum": 0
    },
    "generator_version": {
      "type": "string",
      "minLength": 1
    },
    "action_rules_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  },
  "required": [
    "samples",
    "contexts",
    "dataset_id",
    "version",
    "contract_version",
    "generator_version",
    "action_rules_version",
    "created_at",
    "pipeline_schema_version"
  ],
  "additionalProperties": false
}
