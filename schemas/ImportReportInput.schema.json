{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/ImportReportInput.schema.json",
  "title": "ImportReportInput",
  "description": "게시기 보고서 재료. 도달하지 못한 단계는 null이다(경계 오류로 멈추면 앞 단계만 있다).",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "tolerance": {
      "type": "object",
      "properties": {
        "max_invalid_rows": {
          "type": "integer",
          "minimum": 0
        },
        "max_invalid_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "max_invalid_rows",
        "max_invalid_rate"
      ],
      "additionalProperties": false
    },
    "pending_policy": {
      "enum": [
        "report",
        "exclude",
        "reject"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "ImportTallySummary.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "pii_patterns": {
      "type": "array",
      "items": {
        "enum": [
          "email",
          "phone_landline",
          "phone_mobile",
          "rrn"
        ]
      }
    },
    "pending_excluded": {
      "type": "integer",
      "minimum": 0
    },
    "overlap": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "duplicate_utterances": {
              "type": "object",
              "properties": {
                "EVAL~TRAIN": {
                  "type": "integer",
                  "minimum": 0
                },
                "EVAL~VALIDATION": {
                  "type": "integer",
                  "minimum": 0
                },
                "TRAIN~VALIDATION": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "EVAL~TRAIN",
                "EVAL~VALIDATION",
                "TRAIN~VALIDATION"
              ],
              "additionalProperties": false
            },
            "duplicate_inputs": {
              "type": "object",
              "properties": {
                "EVAL~TRAIN": {
                  "type": "integer",
                  "minimum": 0
                },
                "EVAL~VALIDATION": {
                  "type": "integer",
                  "minimum": 0
                },
                "TRAIN~VALIDATION": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "EVAL~TRAIN",
                "EVAL~VALIDATION",
                "TRAIN~VALIDATION"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "duplicate_utterances",
            "duplicate_inputs"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "PUBLISHED",
                "ALREADY_PUBLISHED"
              ]
            },
            "version": {
              "type": "string"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "dataset_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "status",
            "version",
            "content_hash",
            "dataset_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "dataset_id",
    "tolerance",
    "pending_policy",
    "tool_version",
    "summary",
    "pii_patterns",
    "pending_excluded",
    "overlap",
    "rejected",
    "published",
    "error"
  ],
  "additionalProperties": false
}
