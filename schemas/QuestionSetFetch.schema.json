{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/QuestionSetFetch.schema.json",
  "title": "QuestionSetFetch",
  "description": "읽어 온 문항 세트: ArtifactRef, QuestionBank(계약), 검수 결과(읽었을 때만), 변경 분류의 후속 작업(읽었을 때만; null이면 변경 기록 없음).",
  "type": "object",
  "properties": {
    "ref": {
      "type": "object"
    },
    "bank": {
      "type": "object"
    },
    "approvals": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string"
              },
              "clinical_basis_approved": {
                "type": "boolean"
              }
            },
            "required": [
              "decision",
              "clinical_basis_approved"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "change_checked": {
      "type": "boolean"
    },
    "follow_ups": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_question_ids": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "description": "변경 분류의 affected_slots에서 읽은 문항 ID(정렬). null이면 문항 제한이 없다(변경 분류를 읽지 않았거나 REGENERATE_SAMPLES인데 영향 칸 목록이 비었다)."
    }
  },
  "required": [
    "ref",
    "bank",
    "approvals",
    "change_checked",
    "follow_ups",
    "affected_question_ids"
  ],
  "additionalProperties": false
}
