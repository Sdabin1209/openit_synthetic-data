{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/PublishOutcome.schema.json",
  "title": "PublishOutcome",
  "description": "게시 결과: 새로 게시됨 또는 이미 게시됨(같은 digest).",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "PUBLISHED",
        "ALREADY_PUBLISHED"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "status",
    "content_hash"
  ],
  "additionalProperties": false
}
