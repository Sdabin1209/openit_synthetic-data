{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/RawRow.schema.json",
  "title": "RawRow",
  "description": "입력 파일의 한 줄. text가 null이면 UTF-8이 아닌 줄이다.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "split": {
      "enum": [
        "TRAIN",
        "VALIDATION",
        "EVAL"
      ]
    },
    "lineno": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "role",
    "split",
    "lineno",
    "text"
  ],
  "additionalProperties": false
}
