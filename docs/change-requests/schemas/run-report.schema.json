{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/run-report.schema.json",
  "title": "report.json (run 시드 잡, 초안)",
  "description": "초안(CR-008). run이 <work_dir>/report.json에 쓴다. 경계 오류가 나면 result 대신 error(BoundaryError 레코드)가 있다. 모르는 키 정책: 읽는 쪽은 무시. 불변식: dropped·skipped_seeds는 항상 있다(버린 이유를 숨기지 않는다); result.status가 있으면 dataset_digest도 있다.",
  "type": "object",
  "required": ["job_version", "dataset_id", "notes", "dropped", "skipped_seeds"],
  "properties": {
    "job_version": {"type": "string"},
    "dataset_id": {"$ref": "_defs.schema.json#/$defs/DatasetId"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "dropped": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "skipped_seeds": {"type": "array", "items": {"type": ["object", "string"]}},
    "generation": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "dataset_digest": {"$ref": "_defs.schema.json#/$defs/Sha256Hash"},
    "result": {"type": "object", "additionalProperties": false, "required": ["status", "version", "content_hash"],
               "properties": {"status": {"enum": ["PUBLISHED", "ALREADY_PUBLISHED"]}, "version": {"type": "string"}, "content_hash": {"$ref": "_defs.schema.json#/$defs/Sha256Hash"}}},
    "error": {"type": "object"}
  },
  "allOf": [{"if": {"required": ["result"]}, "then": {"required": ["dataset_digest"]}}]
}
