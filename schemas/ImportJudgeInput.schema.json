{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/ImportJudgeInput.schema.json",
  "title": "ImportJudgeInput",
  "description": "허용치 판정 입력(허용치는 설정에서 오고 기본값이 없다, ADR 0005).",
  "type": "object",
  "properties": {
    "tolerance": {
      "type": "object",
      "properties": {
        "max_invalid_rows": {
          "type": "integer",
          "minimum": 0
        },
        "max_invalid_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_pii_suspect_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "max_invalid_rows",
        "max_invalid_rate",
        "max_pii_suspect_rows"
      ],
      "additionalProperties": false
    },
    "pending_policy": {
      "enum": [
        "report",
        "exclude",
        "reject"
      ]
    },
    "total_rows": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_rows": {
      "type": "integer",
      "minimum": 0
    },
    "valid_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "pending_total": {
      "type": "integer",
      "minimum": 0
    },
    "pii_rows_total": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "tolerance",
    "pending_policy",
    "total_rows",
    "invalid_rows",
    "valid_by_file",
    "pending_total",
    "pii_rows_total"
  ],
  "additionalProperties": false
}
