{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.invalid/synthetic-data/schemas/SeedCollectInput.schema.json",
  "title": "SeedCollectInput",
  "description": "시드 수집 입력. 비식별(deidentified=true)이 아닌 사례는 입력 단계에서 거부한다(브리프 5절).",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "deidentified": {
            "const": true
          }
        },
        "required": [
          "case_id",
          "deidentified"
        ],
        "additionalProperties": true
      }
    },
    "survey_contract_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "cases",
    "survey_contract_version"
  ],
  "additionalProperties": false
}
