{
  "service": "dataset-store",
  "egress": [
    "question-authoring",
    "ops-feedback"
  ],
  "routes": [
    {
      "paths": [
        "/v1/datasets",
        "/v1/datasets/*"
      ],
      "auth": {
        "kind": "denied"
      },
      "max_body_bytes": 1073741824
    },
    {
      "paths": [
        "/healthz",
        "/readyz",
        "/metrics"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "none"
      }
    }
  ]
}
